{
  "name": "central-dos-convenios-cloudflare",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "deploy": "npm run check:config && npm run build && wrangler deploy",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:config": "node scripts/check-config.mjs",
    "db:local": "wrangler d1 migrations apply central_convenios --local",
    "db:remote": "wrangler d1 migrations apply central_convenios --remote"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@supabase/supabase-js": "^2.119.2"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "wrangler": "^4.51.0"
  }
}
